    },
    "license": "MIT",
    "authors": [
        {
            "name": "Erebox",
            "email": "erebox@yahoo.it",
            "role": "lead"
        }
    ],
    "require": {
        "php": ">=7.4",
        "flightphp/core": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "core\\": "src/"
